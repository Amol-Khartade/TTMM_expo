# ==============================================================================
# TTMM (Tera Tu Mera Me) - Environment Template (.env.example)
# ==============================================================================
# Duplicate this file as .env and populate with your own development/production keys.
# In Expo, variables accessible to the client app in JavaScript/TypeScript
# must start with the EXPO_PUBLIC_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Metadata & Environment
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=TTMM
EXPO_PUBLIC_APP_SCHEME=ttmm
EXPO_PUBLIC_APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. Firebase Configuration
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_PROJECT_NUMBER=your-project-number
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Android Client
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=your-android-api-key
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=your-android-app-id

# iOS Client
EXPO_PUBLIC_FIREBASE_IOS_API_KEY=your-ios-api-key
EXPO_PUBLIC_FIREBASE_IOS_APP_ID=your-ios-app-id

# General / Web Firebase API Key fallback
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key

# ------------------------------------------------------------------------------
# 3. Google Gemini AI (Receipt OCR & Auto Expense Extraction)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Google OAuth & Sign-In Client IDs
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-id

# ------------------------------------------------------------------------------
# 4. Expo Application Services (EAS)
# ------------------------------------------------------------------------------
EAS_PROJECT_ID=your-eas-project-id
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# ------------------------------------------------------------------------------
# 5. App Feature Flags & Regional Defaults
# ------------------------------------------------------------------------------
EXPO_PUBLIC_DEFAULT_CURRENCY=INR
EXPO_PUBLIC_DEFAULT_TRANSACTION_NOTE="TTMM Settlement"
EXPO_PUBLIC_ENABLE_SIMPLIFIED_DEBTS=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
